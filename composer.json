{
    "name": "webong/composer-source-plugin",
    "description": "Select one Composer package source and generate optional namespace compatibility aliases.",
    "type": "composer-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": ">=2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "suggest": {
        "wikimedia/composer-merge-plugin": "Merge a local package manifest before the source selector chooses the winning implementation."
    },
    "autoload": {
        "psr-4": {
            "Webong\\ComposerSource\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\ComposerSource\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "Webong\\ComposerSource\\ComposerSourcePlugin",
        "laravel": {
            "providers": [
                "Webong\\ComposerSource\\Illuminate\\ComposerSourceServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
        "webong/composer-source-plugin": true
        }
    }
}
