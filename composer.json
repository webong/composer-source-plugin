{
    "name": "webong/composer-namespace-alias",
    "description": "Generate Composer autoload aliases between PHP namespace prefixes.",
    "type": "composer-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "composer-plugin-api": ">=2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Webong\\ComposerNamespaceAlias\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\ComposerNamespaceAlias\\Tests\\": "tests/"
        }
    },
    "extra": {
        "class": "Webong\\ComposerNamespaceAlias\\NamespaceAliasPlugin"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "webong/composer-namespace-alias": true
        }
    }
}
