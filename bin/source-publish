#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = dirname(__DIR__).'/vendor/autoload.php';
if (! is_file($autoload)) {
    fwrite(STDERR, "Run composer install in the plugin checkout, or use composer source:publish.\n");
    exit(1);
}
require $autoload;
exit(Webong\ComposerSource\PackagePublisher::main($argv));
